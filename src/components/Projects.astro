---
import { useTranslations } from '../i18n/utils';
import { ui } from '../i18n/ui';
import { projectsData } from '../i18n/data';

const lang = (Astro.currentLocale || 'es') as keyof typeof ui;
const t = useTranslations(lang);
const projects = projectsData[lang];
---

<section id="projects" class="container projects-section">
  <h2 class="section-title">{t('projects.title')}</h2>
  <div class="projects-grid">
    {projects.map(project => (
      <div class="project-card glass">
        <div class="project-image"></div>
        <div class="project-info">
          <h3>{project.title}</h3>
          <p>{project.description}</p>
          <div class="project-tech">
            {project.tech.map(t => <span>{t}</span>)}
          </div>
          <a href={project.link} class="project-link">{t('projects.view')}</a>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .projects-section {
    padding: 6rem 0;
  }
  .section-title {
    font-size: 2.5rem;
    margin-bottom: 4rem;
    text-align: center;
  }
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 350px), 1fr));
    gap: 2.5rem;
  }
  .project-card {
    border-radius: 1.5rem;
    overflow: hidden;
    transition: transform 0.3s ease;
  }
  .project-card:hover {
    transform: translateY(-10px);
  }
  .project-image {
    height: 200px;
    background: linear-gradient(45deg, var(--secondary), var(--border));
    position: relative;
  }
  .project-image::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, var(--primary-glow), transparent);
    opacity: 0.2;
  }
  .project-info {
    padding: 2rem;
  }
  .project-info h3 {
    margin-bottom: 1rem;
    font-size: 1.5rem;
  }
  .project-info p {
    color: var(--muted);
    margin-bottom: 2rem;
    font-size: 0.95rem;
  }
  .project-tech {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 2rem;
  }
  .project-tech span {
    font-size: 0.75rem;
    color: var(--primary);
    background: rgba(59, 130, 246, 0.1);
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    font-weight: 600;
  }
  .project-link {
    font-weight: 600;
    color: var(--accent);
    display: inline-block;
  }
</style>
