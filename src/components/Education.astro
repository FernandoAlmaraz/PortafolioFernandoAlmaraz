---
import { useTranslations } from '../i18n/utils';
import { ui } from '../i18n/ui';
import { educationData } from '../i18n/data';

const lang = (Astro.currentLocale || 'es') as keyof typeof ui;
const t = useTranslations(lang);
const educations = educationData[lang];
---

<section id="education" class="container education-section">
  <h2 class="section-title">{t('edu.title')}</h2>
  <div class="education-grid">
    {educations.map(edu => (
      <div class="edu-card glass">
        <div class="edu-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 10v6M2 10l10-5 10 5-10 5z"/>
            <path d="M6 12v5c3 3 9 3 12 0v-5"/>
          </svg>
        </div>
        <div class="edu-info">
          <h3>{edu.title}</h3>
          <span class="edu-institution">{edu.institution}</span>
          <span class="edu-type">{edu.type}</span>
          <p>{edu.description}</p>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .education-section {
    padding: 6rem 0;
  }
  .section-title {
    font-size: 2.5rem;
    margin-bottom: 4rem;
    text-align: center;
  }
  .education-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 2.5rem;
    max-width: 900px;
    margin: 0 auto;
  }
  .edu-card {
    padding: 2rem;
    border-radius: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    transition: transform 0.3s ease;
  }
  .edu-card:hover {
    transform: translateY(-5px);
    border-color: var(--primary);
  }
  .edu-icon {
    width: 3rem;
    height: 3rem;
    background: rgba(59, 130, 246, 0.1);
    color: var(--primary);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .edu-info h3 {
    font-size: 1.3rem;
    margin-bottom: 0.25rem;
  }
  .edu-institution {
    font-size: 1rem;
    color: var(--foreground);
    font-weight: 500;
    margin-bottom: 0.5rem;
    display: block;
  }
  .edu-type {
    display: inline-block;
    font-size: 0.85rem;
    color: var(--accent);
    font-weight: 600;
    margin-bottom: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .edu-info p {
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }
</style>
