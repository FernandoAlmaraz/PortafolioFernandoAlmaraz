---
import { useTranslations } from '../i18n/utils';
import { ui } from '../i18n/ui';
import { skillsData } from '../i18n/data';

const lang = (Astro.currentLocale || 'es') as keyof typeof ui;
const t = useTranslations(lang);
const skills = skillsData[lang];
---

<section id="skills" class="container skills-section">
  <h2 class="section-title">{t('skills.title')}</h2>
  <div class="skills-grid">
    {skills.map(skill => (
      <div class="skill-card glass">
        <h3>{skill.category}</h3>
        <ul>
          {skill.items.map(item => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>

<style>
  .skills-section {
    padding: 6rem 0;
  }
  .section-title {
    font-size: 2.5rem;
    margin-bottom: 4rem;
    text-align: center;
  }
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr));
    gap: 2rem;
  }
  .skill-card {
    padding: 2rem;
    border-radius: 1.5rem;
    transition: transform 0.3s ease;
  }
  .skill-card:hover {
    transform: translateY(-5px);
    border-color: var(--primary);
  }
  .skill-card h3 {
    color: var(--primary);
    margin-bottom: 1.5rem;
    font-size: 1.25rem;
  }
  .skill-card ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .skill-card li {
    background: var(--secondary);
    padding: 0.5rem 1rem;
    border-radius: 0.5rem;
    font-size: 0.9rem;
    border: 1px solid var(--border);
  }
</style>
