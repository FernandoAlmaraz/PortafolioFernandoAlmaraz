---
const experiences = [
  {
    company: "Reborn",
    role: "Software Engineer (Chatbots & Fullstack)",
    date: "Jun 2025 - Oct 2026",
    description: "Chatbot with IA & FullStack Development",
    technologies: ["LangChain", "LangGraph", "Docker", "Astro", "JavaScript", "PHP", "Laravel"]
  },
  {
    company: "Fusion Pax",
    role: "Ingeniero en IA & Automatización",
    date: "Jun 2025 - Sep 2025",
    description: "Automatización y desarrollo con IA.",
    technologies: ["Python", "N8N", "LangChain", "Docker"]
  },
  {
    company: "EasyContact",
    role: "Software Engineer (Chatbots & Fullstack)",
    date: "Jan 2024 - Mar 2025",
    description: "Chatbot with IA & FullStack Development / HALF DAY",
    technologies: ["Python", "LangChain", "LangGraph", "Google Cloud Platform", "Docker", "Angular", "PHP", "Laravel"]
  },
  {
    company: "DATEC",
    role: "Analytical Engineer",
    date: "Apr 2024 - Jul 2025",
    description: "Data Analysis, Web Development, Research, Data Warehouse.",
    technologies: ["Python", "SQL", "SAP DataSphere", "SAC SAP Analytics Cloud", "Google Cloud Platform", "Looker Studio"]
  },
  {
    company: "Bamboo Tec",
    role: "Pasantía: Fullstack Web Development",
    date: "Jul 2022 - Dec 2022",
    description: "Analysis of data, development of ETL processes and research.",
    technologies: ["Python", "JavaScript", "Pandas", "NumPy", "Power BI"]
  }
];
---

<section id="experience" class="container experience-section">
  <h2 class="section-title">Experiencia Profesional</h2>
  <div class="timeline">
    {experiences.map((exp, index) => (
      <div class="timeline-item">
        <div class="timeline-content glass">
          <div class="time">{exp.date}</div>
          <h3 class="title">{exp.role}</h3>
          <div class="company">{exp.company}</div>
          <p class="description">{exp.description}</p>
          <div class="tags">
            {exp.technologies.map(tech => (
              <span class="tag">{tech}</span>
            ))}
          </div>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .experience-section {
    padding: 6rem 0;
  }
  .section-title {
    font-size: 2.5rem;
    margin-bottom: 4rem;
    text-align: center;
  }
  .timeline {
    position: relative;
    max-width: 800px;
    margin: 0 auto;
  }
  .timeline::after {
    content: '';
    position: absolute;
    width: 2px;
    background: var(--border);
    top: 0;
    bottom: 0;
    left: 50%;
    margin-left: -1px;
  }
  .timeline-item {
    padding: 10px 40px;
    position: relative;
    background-color: inherit;
    width: 50%;
  }
  .timeline-item::after {
    content: '';
    position: absolute;
    width: 20px;
    height: 20px;
    right: -10px;
    background-color: var(--background);
    border: 4px solid var(--primary);
    top: 15px;
    border-radius: 50%;
    z-index: 1;
  }
  .timeline-item:nth-child(even) {
    left: 50%;
  }
  .timeline-item:nth-child(odd) {
    left: 0;
  }
  .timeline-item:nth-child(even)::after {
    left: -10px;
  }
  .timeline-content {
    padding: 20px 30px;
    border-radius: 6px;
    position: relative;
  }
  .time {
    color: var(--primary);
    font-weight: 600;
    font-size: 0.9rem;
    margin-bottom: 0.5rem;
  }
  .title {
    font-size: 1.25rem;
    margin-bottom: 0.25rem;
  }
  .company {
    font-size: 1rem;
    color: var(--muted);
    margin-bottom: 1rem;
    font-weight: 500;
  }
  .description {
    margin-bottom: 1rem;
    font-size: 0.95rem;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .tag {
    background: var(--secondary);
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    font-size: 0.75rem;
    color: var(--accent);
    border: 1px solid var(--border);
  }

  @media screen and (max-width: 600px) {
    .timeline::after {
      left: 31px;
    }
    .timeline-item {
      width: 100%;
      padding-left: 70px;
      padding-right: 25px;
    }
    .timeline-item::after {
      left: 21px;
    }
    .timeline-item:nth-child(even) {
      left: 0%;
    }
  }
</style>
