---
import { useTranslations } from '../i18n/utils';
import { ui } from '../i18n/ui';
import { experiencesData } from '../i18n/data';

const lang = (Astro.currentLocale || 'es') as keyof typeof ui;
const t = useTranslations(lang);
const experiences = experiencesData[lang] as Array<any>;
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';
---

<section id="experience" class="container experience-section">
  <h2 class="section-title">{t('exp.title')}</h2>
  <div class="timeline">
    {
      experiences.map((exp, index) => (
        <div class="timeline-item">
          <div class="timeline-content glass">
            <div class="time">{exp.date}</div>
            <h3 class="title">{exp.role}</h3>
            <div class="company">{exp.company}</div>
            <p class="description">{exp.description}</p>
            <div class="tags">
              {exp.technologies.map((tech: string) => (
                <span class="tag">{tech}</span>
              ))}
            </div>
            {exp.recommendation && (
              <a href={`${base}${exp.recommendation}`} target="_blank" rel="noopener noreferrer" class="recommendation-btn">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                  <polyline points="14 2 14 8 20 8"></polyline>
                  <line x1="16" y1="13" x2="8" y2="13"></line>
                  <line x1="16" y1="17" x2="8" y2="17"></line>
                  <polyline points="10 9 9 9 8 9"></polyline>
                </svg>
                {t('exp.recommendation')}
              </a>
            )}
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .experience-section {
    padding: 6rem 0;
  }
  .section-title {
    font-size: 2.5rem;
    margin-bottom: 4rem;
    text-align: center;
  }
  .timeline {
    position: relative;
    max-width: 800px;
    margin: 0 auto;
  }
  .timeline::after {
    content: "";
    position: absolute;
    width: 2px;
    background: var(--border);
    top: 0;
    bottom: 0;
    left: 50%;
    margin-left: -1px;
  }
  .timeline-item {
    padding: 10px 40px;
    position: relative;
    background-color: inherit;
    width: 50%;
  }
  .timeline-item::after {
    content: "";
    position: absolute;
    width: 20px;
    height: 20px;
    right: -10px;
    background-color: var(--background);
    border: 4px solid var(--primary);
    top: 15px;
    border-radius: 50%;
    z-index: 1;
  }
  .timeline-item:nth-child(even) {
    left: 50%;
  }
  .timeline-item:nth-child(odd) {
    left: 0;
  }
  .timeline-item:nth-child(even)::after {
    left: -10px;
  }
  .timeline-content {
    padding: 20px 30px;
    border-radius: 6px;
    position: relative;
  }
  .time {
    color: var(--primary);
    font-weight: 600;
    font-size: 0.9rem;
    margin-bottom: 0.5rem;
  }
  .title {
    font-size: 1.25rem;
    margin-bottom: 0.25rem;
  }
  .company {
    font-size: 1rem;
    color: var(--muted);
    margin-bottom: 1rem;
    font-weight: 500;
  }
  .description {
    margin-bottom: 1rem;
    font-size: 0.95rem;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .tag {
    background: var(--secondary);
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    font-size: 0.75rem;
    color: var(--accent);
    border: 1px solid var(--border);
  }
  .recommendation-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.5rem;
    padding: 0.5rem 1rem;
    background: transparent;
    border: 1px solid var(--primary);
    color: var(--primary);
    border-radius: 9999px;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s ease;
  }
  .recommendation-btn:hover {
    background: var(--primary);
    color: white;
    box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
  }

  @media screen and (max-width: 600px) {
    .timeline::after {
      left: 31px;
    }
    .timeline-item {
      width: 100%;
      padding-left: 70px;
      padding-right: 0px;
    }
    .timeline-item::after, 
    .timeline-item:nth-child(even)::after {
      left: 21px;
      right: auto;
    }
    .timeline-item:nth-child(even) {
      left: 0%;
    }
    .timeline-content {
      padding: 15px 20px;
    }
    .title {
      font-size: 1.1rem;
    }
  }
</style>
