---
import ThemeToggle from "./ThemeToggle.astro";
import { useTranslations } from "../i18n/utils";
import { ui } from "../i18n/ui";

const lang = (Astro.currentLocale || "es") as keyof typeof ui;
const t = useTranslations(lang);
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : rawBase + "/";
---

<nav class="glass sticky-nav">
  <div class="container nav-content">
    <a
      href={`${base}${lang === "en" ? "en/" : ""}`}
      class="logo-link"
      aria-label="Inicio"
    >
      <img
        src={`${base}nav-perfil.jpeg`}
        alt="Fernando Almaraz"
        class="logo-img"
      />
    </a>

    <button class="mobile-menu-btn" aria-label="Menu" id="mobile-menu-btn">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>

    <div class="nav-links" id="nav-links">
      <a href="#hero">{t("nav.home")}</a>
      <a href="#experience">{t("exp.title")}</a>
      <a href="#education">{t("edu.title")}</a>
      <a href="#projects">{t("nav.projects")}</a>
      <a href="#skills">{t("nav.skills")}</a>
      <a
        href={`https://wa.me/59177999469?text=${encodeURIComponent(t("hero.whatsappText"))}`}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-primary">{t("nav.contact")}</a
      >
      <ThemeToggle />
      <div class="lang-picker">
        <a href={base} class={lang === "es" ? "active" : ""}>ES</a>
        <span>|</span>
        <a href={`${base}en/`} class={lang === "en" ? "active" : ""}>EN</a>
      </div>
    </div>
  </div>
</nav>

<style>
  .sticky-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    padding: 1rem 0;
  }
  .nav-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .logo-link {
    display: flex;
    align-items: center;
    text-decoration: none;
  }
  .logo-img {
    height: 58px;
    width: auto;
    border-radius: 4px;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  .logo-img:hover {
    transform: scale(1.05);
  }
  .nav-links {
    display: flex;
    gap: 2rem;
    align-items: center;
  }
  .nav-links a {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--muted);
    transition: color 0.3s ease;
  }
  .nav-links a:hover {
    color: var(--foreground);
  }
  .btn-primary {
    background: var(--primary);
    color: white !important;
    padding: 0.5rem 1.25rem;
    border-radius: 9999px;
  }
  .lang-picker {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    color: var(--muted);
    font-size: 0.9rem;
    font-weight: 600;
  }
  .lang-picker a {
    text-decoration: none;
    transition: color 0.3s;
  }
  .lang-picker a.active {
    color: var(--primary);
  }
  .mobile-menu-btn {
    display: none;
    background: transparent;
    border: none;
    color: var(--foreground);
    cursor: pointer;
    padding: 0.5rem;
  }

  @media (max-width: 768px) {
    .mobile-menu-btn {
      display: block;
    }
    .nav-links {
      position: absolute;
      top: 100%;
      left: 0;
      width: 100%;
      background: var(--background);
      flex-direction: column;
      padding: 2rem;
      border-bottom: 1px solid var(--border);
      gap: 1.5rem;
      transform: translateY(-150%);
      opacity: 0;
      visibility: hidden;
      transition:
        transform 0.3s ease,
        opacity 0.3s ease,
        visibility 0.3s;
      z-index: -1;
    }
    .nav-links.show {
      transform: translateY(0);
      opacity: 1;
      visibility: visible;
      z-index: 999;
    }
    .lang-picker {
      justify-content: center;
    }
  }
</style>

<script>
  const initMobileMenu = () => {
    const btn = document.getElementById("mobile-menu-btn");
    const links = document.getElementById("nav-links");

    if (btn && links) {
      // Remove any existing listener to prevent duplicate firings if script runs multiple times
      const newBtn = btn.cloneNode(true);
      btn.parentNode?.replaceChild(newBtn, btn);

      newBtn.addEventListener("click", () => {
        links.classList.toggle("show");
      });

      const anchorLinks = links.querySelectorAll("a");
      anchorLinks.forEach((a) => {
        a.addEventListener("click", () => {
          links.classList.remove("show");
        });
      });
    }
  };

  // Run on first load and astro view transitions
  initMobileMenu();
  document.addEventListener("astro:page-load", initMobileMenu);
</script>
