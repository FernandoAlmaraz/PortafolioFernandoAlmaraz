---
import ThemeToggle from './ThemeToggle.astro';
import { useTranslations } from '../i18n/utils';
import { ui } from '../i18n/ui';

const lang = (Astro.currentLocale || 'es') as keyof typeof ui;
const t = useTranslations(lang);
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';
---
<nav class="glass sticky-nav">
  <div class="container nav-content">
    <a href={`${base}${lang === 'en' ? 'en/' : ''}`} class="logo text-gradient">FA</a>
    <div class="nav-links">
      <a href="#hero">{t('nav.home')}</a>
      <a href="#experience">{t('nav.experience')}</a>
      <a href="#projects">{t('nav.projects')}</a>
      <a href="#skills">{t('nav.skills')}</a>
      <a href="#contact" class="btn-primary">{t('nav.contact')}</a>
      <ThemeToggle />
      <div class="lang-picker">
        <a href={base} class={lang === 'es' ? 'active' : ''}>ES</a>
        <span>|</span>
        <a href={`${base}en/`} class={lang === 'en' ? 'active' : ''}>EN</a>
      </div>
    </div>
  </div>
</nav>

<style>
  .sticky-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    padding: 1rem 0;
  }
  .nav-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .logo {
    font-size: 1.5rem;
    font-weight: 800;
  }
  .nav-links {
    display: flex;
    gap: 2rem;
    align-items: center;
  }
  .nav-links a {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--muted);
    transition: color 0.3s ease;
  }
  .nav-links a:hover {
    color: var(--foreground);
  }
  .btn-primary {
    background: var(--primary);
    color: white !important;
    padding: 0.5rem 1.25rem;
    border-radius: 9999px;
  }
  .lang-picker {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    color: var(--muted);
    font-size: 0.9rem;
    font-weight: 600;
  }
  .lang-picker a {
    text-decoration: none;
    transition: color 0.3s;
  }
  .lang-picker a.active {
    color: var(--primary);
  }
</style>

