---
<footer class="footer">
  <div class="container footer-grid">
    <div class="footer-info">
      <a href="/" class="logo text-gradient">FA</a>
      <p>Construyendo sistemas escalables y experiencias web modernas.</p>
    </div>
    <div class="footer-links">
      <h4>Enlaces</h4>
      <a href="#hero">Inicio</a>
      <a href="#projects">Proyectos</a>
      <a href="#skills">Habilidades</a>
    </div>
    <div class="footer-social">
      <h4>Conectar</h4>
      <a href="https://github.com/FernandoAlmaraz" target="_blank">GitHub</a>
      <a href="https://www.linkedin.com/in/fernando-gabriel-almaraz-de-la-quintana-4269a4245" target="_blank">LinkedIn</a>
      <a href="mailto:fernandoalmarazdelaquintana@gmail.com">Email</a>
    </div>
  </div>
  <div class="container copyright">
    <p>&copy; {new Date().getFullYear()} Fernando Almaraz. Todos los derechos reservados.</p>
  </div>
</footer>

<style>
  .footer {
    padding: 6rem 0 3rem;
    border-top: 1px solid var(--border);
    margin-top: 6rem;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 4rem;
    margin-bottom: 4rem;
  }
  .logo {
    font-size: 1.5rem;
    font-weight: 800;
    margin-bottom: 1rem;
    display: inline-block;
  }
  .footer-info p {
    color: var(--muted);
    font-size: 0.9rem;
  }
  h4 {
    margin-bottom: 1.5rem;
    font-size: 1rem;
  }
  .footer-links, .footer-social {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .footer-links a, .footer-social a {
    color: var(--muted);
    font-size: 0.9rem;
    transition: color 0.3s ease;
  }
  .footer-links a:hover, .footer-social a:hover {
    color: var(--foreground);
  }
  .copyright {
    text-align: center;
    padding-top: 3rem;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.8rem;
  }
</style>
